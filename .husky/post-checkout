#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Repo root (husky runs from repo root)
REPO_ROOT="$(cd "$(dirname -- "$0")/.." && pwd)"


# 1) Worktree env: in a linked worktree, call the no-write default mode.
#    The linked worktree is detected from git itself, so this
#    works whether the hook runs from the main checkout (`git worktree add`) or from the
#    worktree's own .husky directory (later checkouts). Husky runs hooks with `sh -e`,
#    hence the `|| true` on each probe.
abs_dir() { (cd "$1" 2>/dev/null && pwd -P); }
GIT_DIR_ABS="$(abs_dir "$(git rev-parse --git-dir 2>/dev/null)")" || true
GIT_COMMON_ABS="$(abs_dir "$(git rev-parse --git-common-dir 2>/dev/null)")" || true
WORKTREE_PATH="$(git rev-parse --show-toplevel 2>/dev/null)" || true
if [ -n "$GIT_DIR_ABS" ] && [ "$GIT_DIR_ABS" != "$GIT_COMMON_ABS" ] && [ -n "$WORKTREE_PATH" ]; then
  ENV_SCRIPT="$REPO_ROOT/scripts/copy-env-to-worktree.js"
  [ -f "$ENV_SCRIPT" ] || ENV_SCRIPT="$WORKTREE_PATH/scripts/copy-env-to-worktree.js"
  if [ -f "$ENV_SCRIPT" ] && command -v node >/dev/null 2>&1; then
    (cd "$WORKTREE_PATH" && node "$ENV_SCRIPT") ||
      echo "[worktree-env] Bootstrap check failed. Run: npm run copy:env" >&2
  else
    echo "[worktree-env] Skipped: node or bootstrap script was not found. Run: npm run copy:env" >&2
  fi
fi

# 2) Refresh .cursor/ from foundation only when submodule commit actually changed
#    (branch checkout: $3=1; then check if foundation changed between $1 and $2)
REF_FILE="$REPO_ROOT/.git/foundation_cursor_sync_ref"
if [ -d "$REPO_ROOT/foundation" ] && [ "$3" = "1" ]; then
  FOUNDATION_CHANGED=$(cd "$REPO_ROOT" && git diff-tree -r "$1" "$2" --name-only 2>/dev/null | grep -q '^foundation' && echo 1) || true
  if [ -n "$FOUNDATION_CHANGED" ]; then
    CURRENT=$(cd "$REPO_ROOT" && git ls-tree "$2" foundation 2>/dev/null | awk '{print $3}') || true
    [ -n "$CURRENT" ] && REPO_ROOT="$REPO_ROOT" "$REPO_ROOT/scripts/setup_cursor_from_foundation.sh" && echo "$CURRENT" > "$REF_FILE"
  fi
fi
